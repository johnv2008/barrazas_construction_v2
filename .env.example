APP_NAME="Barraza's Construction"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Los_Angeles
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barrazas_construction
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Required before launch — CA B&P Code 7030.5 requires the CSLB license
# number in all advertising. Digits only, e.g. BUSINESS_LICENSE_NUMBER=1234567
BUSINESS_LICENSE_NUMBER=
BUSINESS_LICENSE_AUTHORITY=CSLB

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Leave blank to disable
# analytics entirely. The tag only renders when APP_ENV=production.
GA_MEASUREMENT_ID=

SESSION_NAME=barrazas_admin_session
SESSION_LIFETIME=1800
ADMIN_PATH=admin

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@barrazasconstruction.com
MAIL_FROM_NAME="Barraza's Construction"
# Where consultation requests are emailed. Leave unset to use the default
# (barrazasconstructioninc@gmail.com). MAIL_FROM_ADDRESS above must stay on
# barrazasconstruction.com regardless -- mail claiming to come FROM a Gmail
# address but sent by the web host fails Gmail's sender checks.
#MAIL_LEAD_TO=
